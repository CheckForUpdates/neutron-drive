[Unit]
Description=Neutron Drive Background Daemon (Unofficial Proton Drive Client)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/usr/bin/env neutron-drive daemon
ExecStop=/usr/bin/env neutron-drive stop
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
